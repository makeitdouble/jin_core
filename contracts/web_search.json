{
  "web_search": {
    "version": 1,
    "description": "Allows the model to request a runtime web search.",
    "runtime_action": "WEB_SEARCH",
    "enable_flag": "CAN_WEB_SEARCH",
    "runtime_order": 20,
    "private_marker": "<WEB_SEARCH>",
    "triggers": [],
    "blockers": [],
    "effects": {
      "emit_followup": true,
      "follow_up_on_fail": false
    },
    "schema": [
      "<WEB_SEARCH> query </WEB_SEARCH>"
    ],
    "rules": [
      "Use this marker for web search by google!"
    ],
    "close_tag": true
  }
}
