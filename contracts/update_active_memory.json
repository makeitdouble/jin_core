{
  "update_active_memory": {
    "version": 2,
    "description": "Allows JIN to update state fields already fixed on an active memory record.",
    "runtime_action": "UPDATE_ACTIVE_MEMORY",
    "enable_flag": "CAN_SAVE_ACTIVE_MEMORY",
    "runtime_order": 230,
    "private_marker": "<UPDATE_ACTIVE_MEMORY>",
    "triggers": [],
    "blockers": [],
    "effects": {
      "emit_followup": false,
      "follow_up_on_fail": true
    },
    "schema": [
      "<UPDATE_ACTIVE_MEMORY>",
      "{\"active_memory_id\":\"abcdef\",\"field_name\":\"new_value\"}",
      "</UPDATE_ACTIVE_MEMORY>",
      "or",
      "<UPDATE_ACTIVE_MEMORY>",
      "{\"active_memory_id\":\"abcdef\",\"fields_to_update\":{\"field_name\":\"new_value\",\"another_field\":\"new_value\"}}",
      "</UPDATE_ACTIVE_MEMORY>",
      "or",
      "<UPDATE_ACTIVE_MEMORY>",
      "{\"active_memory_id\":\"abcdef\",\"field_to_update\":{\"field_name\":\"new_value\"}}",
      "</UPDATE_ACTIVE_MEMORY>"
    ],
    "rules": [
      "Use to update active memory values."
    ],
    "close_tag": true
  }
}
